<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Turkey Map Game | Find the Province</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link rel="stylesheet" href="css/game.css">
</head>
<body>
    <div class="game-container">
        <div class="header">
            <div class="flex-row">
                <span class="province-name">🇹🇷 TURKIYE</span>
                <div class="score-box">🏆 <span id="scoreValue">0</span> / <span id="totalProvinces">81</span></div>
            </div>
            <button id="resetBtn">🔄 YENIDEN BASLA</button>
        </div>
        
        <canvas id="turkeyCanvas" width="800" height="550"></canvas>
        
        <div class="message-area" id="gameMessage">
            ✨ Click on the map to find the target province ✨
        </div>
        
        <div class="info">
            🎯 Find: <span id="targetProvinceDisplay">Loading...</span>
        </div>
        
        <footer>🗺️ Turkey 81 Provinces | Click the correct city on map</footer>
    </div>

    <script src="js/game.js"></script>
</body>
</html>
